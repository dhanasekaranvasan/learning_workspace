    "# @decorator_name\n",
    "def outer(func):\n",
    "    def inner():\n",
    "        print(\"Before funcion execution\")\n",
    "        func()\n",
    "        print(\"After function execution\")\n",
    "    return inner()\n",
    "\n",
    "@outer\n",
    "def testing():\n",
    "    print(\"Testing\")"
   ]
